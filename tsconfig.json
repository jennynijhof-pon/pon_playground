{
  "compilerOptions": {
    "target": "ES2020",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "types": ["@playwright/test", "node"]
  },
  "include": ["tests/**/*.ts", "playwright.config.ts", "src/types/jiraStatus.enums.ts", "src/utils/tdgConfig.ts", "src/api/jiraClients.ts", "src/utils/jiraConfig.ts", "src/auth/auth.setup.ts", "src/setup/**/*.ts", "src/pages/tdgLogin.ts"]
}
