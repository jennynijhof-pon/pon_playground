{
  "name": "pon_playground",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "pnpm exec playwright install",
    "test": "pnpm exec playwright test",
    "test:headed": "pnpm exec playwright test --headed",
    "test:debug": "pnpm exec playwright test --debug",
    "typecheck": "pnpm exec tsc -p tsconfig.json", 
    "test:ui": "pnpm exec playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/form-data": "^2.2.1",
    "@types/node": "^26.2.0",
    "@types/node-fetch": "^2.6.12",
    "playwright": "^1.62.1",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "form-data": "^4.0.6",
    "node-fetch": "^3.3.2"
  }
}
